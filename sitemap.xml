---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% comment %}
    Manual sitemap (no jekyll-sitemap plugin — matches feed.xml convention).
    Emits every rendered HTML page plus all posts, with absolute URLs.
    Pages that noindex-check.html flags are left out: a sitemap must not
    list URLs that tell crawlers not to index them.
  {% endcomment %}
  {% for page in site.html_pages %}
    {% include noindex-check.html p=page %}
    {% unless page.sitemap == false or page.url == "/404.html" or is_noindex %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    {% if page.url == "/" %}<priority>1.0</priority>{% endif %}
  </url>
    {% endunless %}
  {% endfor %}
  {% for term in site.rjecnik %}
  <url>
    <loc>{{ site.url }}{{ term.url }}</loc>{% if term.last_modified_at %}
    <lastmod>{{ term.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
